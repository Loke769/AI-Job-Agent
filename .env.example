# AI Job Agent - Environment Configuration
# Copy this to .env and fill in your values
# NOTE: No subscription needed. Leave OPENAI_API_KEY empty to run fully offline/free (template tailoring).

# Optional: OpenAI / compatible LLM for higher-quality tailoring (falls back to local template if empty)
# Cost ~ $0.002-0.01 per job with gpt-4o-mini. 100 jobs ≈ $0.30-1.00. Free otherwise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Job search preferences (overrides config/settings.yaml if set) — works for ANY role
# Examples: Software Engineer, Data Engineer, Product Manager, UX Designer, Marketing Manager, etc.
TARGET_ROLES=Software Engineer, Backend Engineer, Data Engineer, Product Manager
TARGET_LOCATIONS=Remote, United States
EXCLUDE_COMPANIES=
EXCLUDE_KEYWORDS=intern,principal,staff
MIN_MATCH_SCORE=50

# ATS credentials (optional — Greenhouse/Lever usually don't need login, Workday does)
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# Dashboard
DASHBOARD_PORT=8000
DASHBOARD_HOST=0.0.0.0

# Pipeline behavior
DRY_RUN=true
AUTO_APPROVE=false
MAX_APPLICATIONS_PER_RUN=25
